PORT=8080
APP_ENV=local
DATABASE_URL=postgres://hunin:hunin@localhost:5432/hunin?sslmode=disable
ALLOWED_ORIGINS=http://localhost:5173
# Generate with: openssl rand 32 | base64 | tr '+/' '-_' | tr -d '=\n'
# Changing this dedicated stable key invalidates active short codes; regenerate invitations to recover.
INVITE_CODE_HASH_KEY=replace-with-canonical-unpadded-base64url-32-byte-key
